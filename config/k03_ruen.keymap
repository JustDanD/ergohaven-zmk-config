/*
 * Ergohave K03 Wireless — layout ported from Fuji44
 * Layers: en(0) ru(1) nav(2) sys(3) num(4) sym(5) sym_ru(6) game(7) game_num(8)
 */

#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        enc_vol: enc_vol {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENC_VOL";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };

        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // GRAVE + N1 → ESC (верхний левый угол)
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        // F + J → caps_word (позиции в строке home row: 28 и 31)
        caps {
            bindings = <&caps_word>;
            key-positions = <28 31>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N2))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N1))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;
            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        nexttab: nexttab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp RCTRL>;
            label = "NEXTTAB";
            wait-ms = <10>;
        };

        prevtab: prevtab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RCTRL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp RCTRL &kp LEFT_SHIFT>;
            label = "PREVTAB";
            wait-ms = <15>;
        };

        nextgroup: nextgroup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp LEFT_ALT>,
                <&macro_tap>,
                <&kp DOWN_ARROW>,
                <&macro_release>,
                <&kp LEFT_GUI &kp LEFT_ALT>;
            label = "NEXTGROUP";
            wait-ms = <10>;
        };

        prevgroup: prevgroup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp LEFT_ALT>,
                <&macro_tap>,
                <&kp UP_ARROW>,
                <&macro_release>,
                <&kp LEFT_GUI &kp LEFT_ALT>;
            label = "PREVGROUP";
            wait-ms = <10>;
        };

        nextproj: nextproj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RCTRL &kp LEFT_ALT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp RCTRL &kp LEFT_ALT>;
            label = "NEXTPROJ";
            wait-ms = <10>;
        };

        prevproj: prevproj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RCTRL &kp LEFT_ALT &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp RCTRL &kp LEFT_ALT &kp LEFT_SHIFT>;
            label = "PREVPROJ";
            wait-ms = <10>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ── 0: EN ─────────────────────────────────────────────────────────────
        en {
            display-name = "Base";
            bindings = <
&kp GRAVE  &kp N1            &kp N2        &kp N3        &kp N4            &kp N5                               &kp N6      &kp N7            &kp N8      &kp N9           &kp N0           &none
&kp ESC    &kp Q             &kp W         &kp E         &kp R             &kp T                                &kp Y       &kp U             &kp I       &kp O            &kp P            &kp MINUS
&kp TAB    &hrm LCTRL A      &hrm LALT S   &hrm LGUI D   &hrm LSHFT F      &kp G                                &kp H       &hrm RSHFT J      &hrm RGUI K &hrm RALT L      &hrm RCTRL SEMI  &kp SQT
&kp LSHFT  &kp Z             &kp X         &kp C         &kp V             &kp B       &kp LBKT    &kp RBKT     &kp N       &kp M             &kp COMMA   &kp DOT          &kp FSLH         &kp BACKSLASH
                             &kp RALT      &kp LBKT      &layer_ru         &lt 2 TAB   &lt 3 SPACE              &lt 4 ENTER &lt 5 BACKSPACE   &kp DEL     &kp RBKT         &trans
            >;
            sensor-bindings = <&enc_vol>;
        };

        // ── 1: RU ─────────────────────────────────────────────────────────────
        ru {
            display-name = "Ru";
            bindings = <
&kp GRAVE  &kp N1                     &kp N2                         &kp N3                      &kp N4                         &kp N5                                                                    &kp N6             &kp N7                        &kp N8                       &kp N9                        &kp N0                      &none
&kp ESC    &kp RU_CYRILLIC_SHORT_I    &kp RU_CYRILLIC_TSE            &kp RU_CYRILLIC_U           &kp RU_CYRILLIC_KA             &kp RU_CYRILLIC_IE                                                        &kp RU_CYRILLIC_EN &kp RU_CYRILLIC_GHE           &kp RU_CYRILLIC_SHA          &kp RU_CYRILLIC_SHCHA         &kp RU_CYRILLIC_ZE          &kp MINUS
&kp TAB    &hrm LCTRL RU_CYRILLIC_EF  &hrm LALT RU_CYRILLIC_YERU     &hrm LGUI RU_CYRILLIC_VE    &hrm LSHFT RU_CYRILLIC_A       &kp RU_CYRILLIC_PE                                                        &kp RU_CYRILLIC_ER &hrm RSHFT RU_CYRILLIC_O      &hrm RGUI RU_CYRILLIC_EL     &hrm RALT RU_CYRILLIC_DE      &hrm RCTRL RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_E
&kp LSHFT  &kp RU_CYRILLIC_YA         &kp RU_CYRILLIC_CHE            &kp RU_CYRILLIC_ES          &kp RU_CYRILLIC_EM             &kp RU_CYRILLIC_I    &kp RU_CYRILLIC_HA    &kp RU_CYRILLIC_HARD_SIGN     &kp RU_CYRILLIC_TE &kp RU_CYRILLIC_SOFT_SIGN     &kp RU_CYRILLIC_BE           &kp RU_CYRILLIC_YU            &kp RU_DOT                  &kp BACKSLASH
                                      &kp RALT                       &kp LBKT                    &layer_en                      &lt 2 TAB            &lt 3 SPACE                                           &lt 4 ENTER        &lt 6 BACKSPACE               &kp DEL                      &kp RBKT                      &trans
            >;
            sensor-bindings = <&enc_vol>;
        };

        // ── 2: NAV ────────────────────────────────────────────────────────────
        nav {
            display-name = "Nav";
            bindings = <
&kp F1   &kp F2    &kp F3         &kp F4        &kp F5         &kp F6                       &kp F7           &kp F8          &kp F9            &kp F10         &kp F11      &kp F12
&trans   &trans    &kp HOME       &kp UP        &kp END        &kp INS                      &kp PG_UP        &kp N7          &kp N8            &kp N9          &trans       &trans
&trans   &trans    &kp LEFT       &kp DOWN      &kp RIGHT      &kp RET                      &kp PG_DN        &kp N4          &kp N5            &kp N6          &trans       &trans
&trans   &trans    &kp LG(PG_DN)  &kp CAPS      &kp LG(PG_UP)  &kp DEL     &trans  &trans   &kp PRINTSCREEN  &kp N1          &kp N2            &kp N3          &trans       &trans
                   &trans         &trans        &trans         &trans      &trans           &mo 3            &trans          &kp N0            &trans          &trans
            >;
        };

        // ── 3: SYS ────────────────────────────────────────────────────────────
        sys {
            display-name = "Sys";
            bindings = <
&bootloader  &trans          &trans        &trans  &trans         &tog 7                         &trans        &bt BT_SEL 0    &bt BT_SEL 1      &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_CLR_ALL
&trans       &trans          &prevproj     &trans  &nextproj      &trans                         &trans        &mmv MOVE_LEFT  &mmv MOVE_DOWN    &mmv MOVE_UP  &mmv MOVE_RIGHT  &studio_unlock
&trans       &trans          &prevtab      &trans  &nexttab       &trans                         &out OUT_BLE  &kp C_VOL_DN    &kp C_MUTE        &kp C_VOL_UP  &trans           &trans
&sys_reset   &bt BT_CLR_ALL  &prevgroup    &trans  &nextgroup     &trans    &trans    &trans      &out OUT_USB  &kp C_PREV      &kp C_PLAY_PAUSE  &kp C_NEXT    &trans           &trans
                             &trans        &trans  &trans         &trans    &trans               &trans        &trans          &trans            &trans        &trans
            >;
        };

        // ── 4: NUM ────────────────────────────────────────────────────────────
        num {
            display-name = "Num";
            bindings = <
&trans                 &trans     &trans     &trans        &trans     &trans                       &trans   &trans   &trans   &trans   &trans   &trans
&kp LEFT_PARENTHESIS   &kp MINUS  &kp SLASH  &kp ASTERISK  &kp EQUAL  &kp PLUS                     &trans   &kp N7   &kp N8   &kp N9   &trans   &kp MINUS
&kp COMMA              &kp N1     &kp N2     &kp N3        &kp N4     &kp N5                       &kp N6   &kp N4   &kp N5   &kp N6   &kp N0   &kp PERIOD
&kp RIGHT_PARENTHESIS  &trans     &trans     &trans        &trans     &trans    &trans    &trans    &trans   &kp N1   &kp N2   &kp N3   &trans   &kp SLASH
                                  &trans     &trans        &trans     &trans    &kp SPACE           &trans   &trans   &kp N0   &trans   &trans
            >;
        };

        // ── 5: SYM (EN) ───────────────────────────────────────────────────────
        sym {
            display-name = "Sym";
            bindings = <
&trans    &trans    &trans     &trans     &trans     &trans                      &trans     &trans    &trans    &trans     &trans    &trans
&kp EXCL  &kp AT    &kp HASH   &kp DLLR   &kp PRCNT  &kp CARET                   &kp AMPS   &kp STAR  &kp PIPE  &kp TILDE  &kp FSLH  &kp BSLH
&kp LT    &kp LBKT  &kp LPAR   &kp LBRC   &kp EQUAL  &kp COLON                   &kp SEMI   &kp RBRC  &kp RPAR  &kp RBKT   &kp GT    &kp UNDER
&kp DQT   &kp SQT   &kp GRAVE  &kp QMARK  &kp PLUS   &kp MINUS   &trans  &trans  &kp COMMA  &kp DOT   &trans    &trans     &trans    &trans
                    &trans     &trans     &trans     &mo 3       &kp SPACE       &kp ENTER  &trans    &trans    &trans     &trans
            >;
        };

        // ── 6: SYM_RU ─────────────────────────────────────────────────────────
        sym_ru {
            display-name = "Sym Ru";
            bindings = <
&trans    &trans        &trans        &trans           &trans          &trans                              &trans          &trans        &trans    &trans     &trans       &trans
&kp EXCL  &en AT_SIGN   &en HASH      &en DOLLAR       &kp RU_PERCENT  &en CARET                           &en AMPERSAND   &kp RU_ASTRK  &en PIPE  &en TILDE  &kp RU_FSLH  &kp RU_BSLH
&en LT    &en LBKT      &kp LPAR      &en LBRC         &kp EQUAL       &kp RU_COLON                        &kp RU_SEMI     &en RBRC      &kp RPAR  &en RBKT   &en GT       &kp UNDER
&en DQT   &en SQT       &en GRAVE     &kp RU_QUESTION  &kp PLUS        &kp MINUS     &trans    &trans      &kp RU_COMMA    &kp RU_DOT    &trans    &trans     &trans       &trans
                        &trans        &trans           &trans          &mo 3         &kp SPACE             &kp ENTER       &trans        &trans    &trans     &trans
            >;
        };

        // ── 7: GAME ───────────────────────────────────────────────────────────
        game {
            display-name = "Game";
            bindings = <
&kp ESC    &kp N1     &kp N2     &kp N3     &kp N4  &kp N5                       &trans     &trans  &trans  &trans  &trans  &trans
&kp TAB    &kp Q      &kp E      &kp W      &kp R   &kp T                        &trans     &trans  &trans  &trans  &trans  &trans
&kp LCTRL  &kp A      &kp A      &kp S      &kp D   &kp G                        &trans     &trans  &trans  &trans  &trans  &trans
&kp LSHFT  &kp Z      &kp X      &kp C      &kp V   &kp B    &trans    &trans    &trans     &trans  &trans  &trans  &trans  &trans
                      &kp LSHFT  &kp LCTRL  &mo 8   &kp SPACE                   &kp ENTER  &tog 7  &trans  &trans  &trans
            >;
        };

        // ── 8: GAME_NUM ───────────────────────────────────────────────────────
        game_num {
            display-name = "GNum";
            bindings = <
&kp GRAVE  &kp N1  &kp N2    &kp UP    &kp N4     &kp N5                     &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp N6  &kp LEFT  &kp DOWN  &kp RIGHT  &kp N3                     &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp F1  &kp F2    &kp F3    &kp F4     &kp F5                     &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans    &trans    &trans     &trans   &trans    &trans   &trans  &trans  &trans  &trans  &trans  &trans
                   &trans    &trans    &trans     &trans                      &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
